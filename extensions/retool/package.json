{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "retool-documentation",
  "title": "Retool Documentation",
  "version": "1.0.0",
  "description": "Search the Retool documentation from Raycast",
  "icon": "icon.png",
  "author": "andre347",
  "contributors": [
    "marks"
  ],
  "categories": [
    "Documentation"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "index",
      "title": "Search Documentation",
      "subtitle": "Retool",
      "description": "Search the Retool documentation from Raycast",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.94.0",
    "algoliasearch": "^4.14.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "eslint": "^7.32.0",
    "prettier": "^2.5.1",
    "react": "^18.2.0",
    "react-devtools": "^6.1.1",
    "typescript": "^4.4.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint"
  }
}
