{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "retool-documentation",
  "title": "Retool Documentation",
  "version": "1.0.0",
  "description": "Search the Retool documentation from Raycast",
  "icon": "icon.png",
  "author": "andre347",
  "contributors": [
    "marks"
  ],
  "categories": [
    "Documentation"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "index",
      "title": "Search Documentation",
      "subtitle": "Retool",
      "description": "Search the Retool documentation from Raycast",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.99.2",
    "algoliasearch": "^4.22.1"
  },
  "devDependencies": {
    "@types/algoliasearch": "^3.34.11",
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.61",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.5",
    "prettier": "^3.2.5",
    "react": "^18.2.0",
    "typescript": "^5.3.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint"
  }
}
